    {
      "id": "drat_trim-1",
      "severity": "Critical",
      "summary": "dratify keeps a literal in the root assignment after deleting the only clause implying it, on both engines, so it returns ok=True on satisfiable formulas"
    },
    {
      "id": "drat_trim-2",
      "severity": "Note",
      "summary": "rate, with unit deletions honoured, rejects proofs dratify accepts because dratify documents ignoring them; rate -d agrees with dratify"
    },
    {
      "id": "drat_trim-3",
      "severity": "Note",
      "summary": "rate verifies a proof that reaches a propagation conflict without writing the empty clause; dratify documents rejecting it"
    },
    {
      "id": "drat_trim-4",
      "severity": "Note",
      "summary": "rate's backward modes verify proofs with an invalid unused lemma; dratify and rate -f reject them, as the README documents"
    },
    {
      "id": "drat_trim-5",
      "severity": "Note",
      "summary": "once propagation has refuted the clauses, dratify keeps treating them as refuted after a deletion undoes the conflict; sound, and rate agrees"
    }
