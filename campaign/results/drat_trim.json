  "findings": [
    {
      "id": "drat_trim-1",
      "status": "fixed",
      "severity": "Critical",
      "summary": "dratify kept a literal in the root assignment after deleting the only clause implying it, on both engines, so it returned ok=True on satisfiable formulas"
    },
    {
      "id": "drat_trim-2",
      "severity": "Note",
      "summary": "rate, with unit deletions honoured, rejects proofs dratify accepts because dratify documents ignoring them; rate -d agrees with dratify"
    },
    {
      "id": "drat_trim-3",
      "severity": "Note",
      "summary": "rate verifies a proof that reaches a propagation conflict without writing the empty clause; dratify documents rejecting it"
    },
    {
      "id": "drat_trim-4",
      "severity": "Note",
      "summary": "rate's backward modes verify proofs with an invalid unused lemma; dratify and rate -f reject them, as the README documents"
    },
    {
      "id": "drat_trim-6",
      "severity": "Note",
      "summary": "drat-trim falls back to every literal of a lemma as the RAT pivot, in both modes; dratify documents the first literal only"
    },
    {
      "id": "drat_trim-7",
      "severity": "Note",
      "summary": "drat-trim's backward mode skips a RAT candidate not yet marked as used, so it accepts a used lemma that is not RAT on the clauses present"
    },
    {
      "id": "drat_trim-10",
      "severity": "Note",
      "summary": "drat-trim reads past its clause database at a final empty clause with no conflict behind it, and can segfault; retried, it answers NOT VERIFIED, as dratify does"
    },
    {
      "id": "drat_trim-8",
      "severity": "Note",
      "summary": "drat-trim's parser reads `d 0` and then swallows the next token of the proof, so the next lemma can become a deletion; found by hand, pinned by --self-test"
    },
    {
      "id": "drat_trim-9",
      "severity": "Note",
      "summary": "no drat-trim mode honours a unit deletion and also checks a refutation: -S checks deletions and skips additions, so it is counted and not compared"
    },
    {
      "id": "drat_trim-11",
      "severity": "Note",
      "summary": "dratify's root-unit test keeps more clauses than drat-trim's reason test, and no verdict moved on either side; one README sentence claims otherwise"
    }
  ],
  "mismatch_kinds": [],
  "not_checked": [
    "drat-trim's -p plain mode, -u, -O and its LRAT and core outputs: only -I, -f, -v, -S and -t were run. -W was run by hand on the two named cases, not on the corpus",
    "any drat-trim commit but the one recorded under external_checkers, and any build but cc -std=c99 -O2 on macOS arm64: its crash depends on what the heap holds",
    "drat-trim's binary proof reading: text only, with -I, and without it as a control",
    "rate with no -p flag, where it tries every literal as a pivot",
    "rate's LRAT and GRAT output, and DPR proofs",
    "binary DRAT: dratify documents text proofs only",
    "minisat: it writes no DRAT proof, so it contributed no proofs",
    "the oracle past 16 variables: the large solver proofs are judged by dratify and drat-trim alone, up to 120 variables, which is not the README's uuf and php scale",
    "tautological clauses in the input formula, and DIMACS parsing corners",
    "the list-of-steps and MemoryProof paths into check_proof: only proof text is passed",
    "that the root-unit test and the reason test can never give different verdicts: that rests on the argument in drat_trim-11 and on the proofs run here, not on a proof checked by machine"
  ]
